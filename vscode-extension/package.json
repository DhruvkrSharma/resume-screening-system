{
  "name": "cloud-runtime",
  "displayName": "Cloud Runtime",
  "description": "Submit code from VSCode to a cloud notebook runtime (Kaggle/other) and stream results live.",
  "version": "0.1.0",
  "publisher": "resume-screening-system",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "cloudRuntime.run",
        "title": "Run on Cloud Runtime",
        "icon": "$(play)"
      }
    ],
    "configuration": {
      "title": "Cloud Runtime",
      "properties": {
        "cloudRuntime.serverUrl": {
          "type": "string",
          "default": "http://localhost:8000",
          "description": "Base URL of the Cloud Runtime API server (e.g. http://localhost:8000)."
        },
        "cloudRuntime.apiToken": {
          "type": "string",
          "default": "",
          "description": "Bearer token for API authentication. Leave empty when API_TOKEN is not set on the server."
        }
      }
    },
    "menus": {
      "editor/title": [
        {
          "command": "cloudRuntime.run",
          "when": "editorLangId == python",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.80.0",
    "@types/ws": "^8.5.10",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "ws": "^8.16.0"
  }
}
