# ── Cloud Notebook Runtime ──────────────────────────────────────────
# Provider selection
RUNTIME_PROVIDER=kaggle

# Kaggle credentials (required for real Kaggle API integration)
# Get your API key at https://www.kaggle.com/settings/account
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key

# API server (defaults to localhost-only; set 0.0.0.0 to expose externally)
API_HOST=127.0.0.1
API_PORT=8000

# Bearer token for API authentication (leave empty to disable auth)
API_TOKEN=

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
